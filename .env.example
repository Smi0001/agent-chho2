# Copy to .env and fill in. NEVER commit your real .env (it is gitignored).

# --- Claude via your Claude Code subscription (Pro/Max/Team) ---
# Generate with:  claude setup-token
# Used by the "claude-agent" provider — no separate API billing.
CLAUDE_CODE_OAUTH_TOKEN=

# --- Or Claude via a metered Anthropic API key ---
# https://console.anthropic.com/settings/keys  (used by the "vercel" provider)
ANTHROPIC_API_KEY=

# --- Other providers for the "vercel" adapter (all optional) ---
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Local models (Ollama) need no key — set baseURL in your .chho2.json instead.

# --- GitHub capability (dev/qa roles) ---
# Fine-grained or classic PAT for the official GitHub MCP server (run via Docker).
# Scope it to only the repos/permissions the roles need (e.g. contents + pull_requests).
# Read from the environment only; never commit a real token. Requires Docker installed.
GITHUB_PERSONAL_ACCESS_TOKEN=

# --- Gitea capability (dev role) ---
# Access token for the official Gitea MCP server (run via Docker). Read from env only.
GITEA_ACCESS_TOKEN=
# Required: your Gitea host (no universal SaaS). Self-hosted, e.g.
# https://gitea.example.com — or the hosted https://gitea.com
GITEA_HOST=

# --- GitLab capability (dev role) ---
# PAT for the GitLab MCP server (run via Docker). Read from env only; never commit.
# Scope to read_api (read-only) or api (also write: MRs, comments). Set an expiry.
GITLAB_PERSONAL_ACCESS_TOKEN=
# Optional. Defaults to https://gitlab.com/api/v4 (SaaS). Set for a self-hosted instance.
GITLAB_API_URL=

# --- Atlassian capability (qa role) ---
# Auth is via OAuth in the browser (handled by mcp-remote on first connect, cached) —
# no token here. Optional: set your Atlassian site host (e.g. your-site.atlassian.net)
# so the agent passes it as the Jira/Confluence cloudId and skips the slower
# resource-discovery call (helps smaller models too).
ATLASSIAN_SITE=

# --- Email notifications (optional; feature B) ---
CHHO2_SMTP_URL=
CHHO2_NOTIFY_EMAIL=
