# Copy to .env and fill in. NEVER commit your real .env (it is gitignored).

# --- Claude via your Claude Code subscription (Pro/Max/Team) ---
# Generate with:  claude setup-token
# Used by the "claude-agent" provider — no separate API billing.
CLAUDE_CODE_OAUTH_TOKEN=

# --- Or Claude via a metered Anthropic API key ---
# https://console.anthropic.com/settings/keys  (used by the "vercel" provider)
ANTHROPIC_API_KEY=

# --- Other providers for the "vercel" adapter (all optional) ---
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Local models (Ollama) need no key — set baseURL in your .chho2.json instead.

# --- Email notifications (optional; feature B) ---
CHHO2_SMTP_URL=
CHHO2_NOTIFY_EMAIL=
